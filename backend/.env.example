# ── Disaster Response 360 Environment Configuration ───────────────────
APP_NAME="Disaster Response 360"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+asyncpg://dr360:dev_password_change_in_prod@localhost:5432/disaster_response_360
# SQLite (Local development without Docker):
DATABASE_URL=sqlite+aiosqlite:///./dr360.db

# ── Security ─────────────────────────────────────────────────────────────
SECRET_KEY=94c8651f8a7e02d6b38c1a792e3a1f945a0e9d6c7b8a1f2e3d4c5b6a7b8c9d0e
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ── Storage ──────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── Redis (optional) ─────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Integrations ─────────────────────────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── Limits ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOADS_PER_REPORT=10
